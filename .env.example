# Bem-te-vi — modelo de variáveis de ambiente (SEM credenciais).
# Copie para .env.local (ignorado pelo Git) quando houver um projeto Supabase. Nesta fase, nenhuma é obrigatória.

# --- Públicas (vão para o navegador no build; sujeitas ao RLS) ---
# URL do projeto Supabase, ex.: https://<referencia-do-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Chave PUBLICÁVEL (sb_publishable_…). Nunca coloque a chave secreta aqui.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Somente servidor / rotinas de ingestão (NUNCA com prefixo NEXT_PUBLIC_) ---
# Chave secreta (sb_secret_… / service_role): ignora o RLS. Só em variáveis de servidor e secrets de CI.
# Ainda não utilizada pelo código.
SUPABASE_SECRET_KEY=
