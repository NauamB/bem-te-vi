# Bem-te-vi — modelo de variáveis de ambiente (SEM credenciais).
# Copie para .env.local (ignorado pelo Git) e preencha só o que for usar. Nunca versione valores reais.

# --- Públicas (vão para o navegador no build; sujeitas ao RLS) ---
# URL do projeto Supabase, ex.: https://<referencia-do-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Chave PUBLICÁVEL (sb_publishable_…). Nunca coloque a chave secreta aqui.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Somente servidor / rotinas locais (NUNCA com prefixo NEXT_PUBLIC_) ---
# Leitura do site (API /api/v1, lib/banco/leitura.ts): string do pooler do Supabase com o papel de LOGIN do site,
# membro de bemtevi_leitura (usuário <papel>.<ref-do-projeto>). Só lê o schema publico; usuário postgres é recusado.
# Esse papel ainda não existe: sua criação depende de autorização. Na Vercel, como variável de servidor.
BANCO_LEITURA_URL=

# Administração local (migrações, inspeção e publicação dos dados): string do pooler de SESSÃO do Supabase,
# com o usuário postgres. Só no .env.local da máquina do proprietário; nunca na Vercel nem no navegador.
SUPABASE_DB_URL=

# Conta GBIF do proprietário, para solicitar downloads oficiais com DOI (scripts/ingestao/gbif.mjs).
GBIF_USUARIO=
GBIF_SENHA=

# Chave secreta (sb_secret_… / service_role): ignora o RLS. Não é usada pelo código.
SUPABASE_SECRET_KEY=
